rules_version = '2';

// Storage rules for ImageRecognition.
// Paste into Firebase console → Storage → Rules → Publish.
// Anything not matched below is denied.
service firebase.storage {
  match /b/{bucket}/o {

    // Face photos uploaded by ImageManager.uploadImage (faceR/<UUID>.jpg).
    // Only signed-in users can upload or list them, images only, max 10 MB.
    // Azure fetches the photo through its tokenized download URL,
    // which works without these read rules.
    match /faceR/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
