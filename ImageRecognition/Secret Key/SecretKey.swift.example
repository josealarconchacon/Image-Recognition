import Foundation

class SecretKeys {
    static let APIKey = "YOUR_AZURE_FACE_API_KEY"
    /// Azure Face API subscription key, used by every FaceAPI request.
    static let faceAPIKey = "YOUR_AZURE_FACE_API_KEY"
}
